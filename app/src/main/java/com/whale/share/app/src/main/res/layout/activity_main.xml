<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    android:gravity="center_horizontal">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="مشارك المجموعات التلقائي"
        android:textSize="22sp"
        android:textStyle="bold"
        android:layout_marginBottom="24dp"
        android:textColor="#1877F2" />

    <!-- حقل رابط البوست -->
    <EditText
        android:id="@+id/etPostLink"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="ضع رابط منشور فيسبوك هنا"
        android:inputType="textUri"
        android:layout_marginBottom="16dp"
        android:padding="12dp"
        android:background="@android:drawable/editbox_background" />

    <!-- حقل روابط الجروبات -->
    <EditText
        android:id="@+id/etGroupLinks"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:hint="ضع روابط المجموعات هنا (كل رابط في سطر منفصل)"
        android:gravity="top"
        android:inputType="textMultiLine"
        android:layout_marginBottom="16dp"
        android:padding="12dp"
        android:background="@android:drawable/editbox_background" />

    <!-- عداد الثواني المتبقية -->
    <TextView
        android:id="@+id/tvTimer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="العداد: جاهز لبدء العمل"
        android:textSize="18sp"
        android:textColor="#FF0000"
        android:layout_marginBottom="16dp"
        android:textStyle="bold" />

    <!-- زر بدء التشغيل -->
    <Button
        android:id="@+id/btnStartShare"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="ابدأ النشر التلقائي"
        android:textSize="18sp"
        android:backgroundTint="#1877F2"
        android:textColor="#FFFFFF"
        android:padding="12dp" />

</LinearLayout>
